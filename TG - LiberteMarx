var MOTSCLES = ["forces productives","rapports de production","superstructure","conscience","être social","aliénation","extérieur","travail forcé","moyen de travail","outil","animal","société","individu","base","révolution","propriété","langage","essence","contrainte","entraves"];
function analyserParagraphe(texte){
  var n = norm(texte);
  if(n.length < 4) return;
  var trouves = MOTSCLES.filter(function(m){ return n.indexOf(norm(m)) !== -1; }).slice(0, 8);
  if(!trouves.length) return;
  var derniere = etat.stratesTags[etat.stratesTags.length - 1];
  if(derniere && derniere.tags.join(",") === trouves.join(",")) return;
  etat.stratesTags.push({ extrait: texte.slice(0, 60), tags: trouves });
  sauverEtat();
  rendreCascadeTags();
}
function rendreCascadeTags(){
  var l = document.getElementById('cascade-liste');
  l.innerHTML = "";
  var total = etat.stratesTags.length;
  etat.stratesTags.forEach(function(strate, i){
    var ligne = document.createElement('div');
    ligne.className = "strate-tags";
    ligne.style.opacity = Math.max(0.32, 1 - ((total - 1 - i) * 0.22)).toFixed(2);
    strate.tags.forEach(function(m){
      var b = document.createElement('button');
      b.type = "button";
      var sel = etat.tagsSelectionnes.indexOf(m) !== -1;
      b.className = "tag-nuage" + (sel ? " selectionne" : "");
      b.textContent = m;
      b.onclick = function(){
        var p = etat.tagsSelectionnes.indexOf(m);
        if(p >= 0) etat.tagsSelectionnes.splice(p, 1); else etat.tagsSelectionnes.push(m);
        sauverEtat(); rendreCascadeTags();
      };
      ligne.appendChild(b);
    });
    l.appendChild(ligne);
  });
  l.scrollTop = l.scrollHeight;
}
document.getElementById('btn-selectionner-tags').onclick = function(){
  if(!etat.tagsSelectionnes.length){ etat.qcmActifsIds = []; zoneQcmWrapper.hidden = true; sauverEtat(); return; }
  var ens = {};
  BASE_QCM.forEach(function(q){
    var sources = [q.name];
    if(q.options) q.options.forEach(function(o){ if(o.correct) sources.push(o.text, o.feedback || ""); });
    if(q.answers) sources.push(q.answers.join(" "));
    if(q.pairs) q.pairs.forEach(function(p){ sources.push(p.q, p.a); });
    var blob = norm(sources.join(" "));
    etat.tagsSelectionnes.forEach(function(t){ if(blob.indexOf(norm(t)) !== -1) ens[q.id] = true; });
  });
  etat.qcmActifsIds = Object.keys(ens);
  etat.qIndex = 0; etat.score = 0; etat.ans = {}; etat.answered = false;
  sauverEtat();
  if(etat.qcmActifsIds.length){ zoneQcmWrapper.hidden = false; renderQCM(); }
  else zoneQcmWrapper.hidden = true;
};
document.getElementById('btn-deselectionner-tags').onclick = function(){
  etat.tagsSelectionnes = []; sauverEtat(); rendreCascadeTags();
};

