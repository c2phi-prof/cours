  if(paras.length >= 1) analyserParagraphe(paras[paras.length - 1].innerText || "");
});

function obtenirQcmActifs(){
  return etat.qcmActifsIds.map(function(id){ return BASE_QCM.filter(function(q){ return q.id === id; })[0]; }).filter(Boolean);
}
function renderQCM(){
  var Q = obtenirQcmActifs();
  if(!Q.length){ zoneQcmWrapper.hidden = true; return; }
  zoneQcmWrapper.hidden = false;
  if(etat.qIndex >= Q.length) etat.qIndex = 0;
  etat.answered = false;
  var q = Q[etat.qIndex];
  var segments = Q.map(function(item, idx){
    var a = etat.ans[idx];
    var cls = "segment-prog";
    if(idx === etat.qIndex) cls += " courant";
    else if(a && a.ok) cls += " fait-ok";
    else if(a && !a.ok) cls += " fait-ko";
    return '<span class="' + cls + '" data-qidx="' + idx + '" title="Question ' + (idx + 1) + '"></span>';
  }).join("");
  var h = '<div class="jauge-segments">' + segments + '</div>';
  h += '<div style="margin-bottom:12px"><span class="mini-tag">' + esc(q.categorie) + '</span> <span class="mini-tag">' + esc(q.scenario) + '</span></div>';
  h += '<p class="qtext">' + esc(q.name) + '</p>';
  if(q.type === "single" || q.type === "multi"){
    var perm = shuffle(q.options.map(function(o, k){ return k; }));
    etat.perm = perm;
    perm.forEach(function(orig, d){
      h += '<label class="opt" id="opt' + d + '"><input type="' + (q.type === "single" ? "radio" : "checkbox") + '" name="q" value="' + d + '" onchange="markSel()"> ' + esc(q.options[orig].text) + '</label>';
    });
  } else if(q.type === "short"){
    h += '<input type="text" id="shortin" placeholder="Votre réponse…" onkeydown="if(event.key===\'Enter\'){event.preventDefault();validate();}">';
  } else if(q.type === "long"){
    h += '<textarea id="longin" style="width:100%;min-height:150px;font-family:var(--font);line-height:1.58;resize:vertical;border:1px solid var(--line);border-radius:7px;padding:9px 11px;background:var(--card);color:var(--ink)"></textarea>';
  } else if(q.type === "matching"){
    var pool = shuffle(q.pairs.map(function(p){ return p.a; }));
    q.pairs.forEach(function(p, k){
      h += '<div style="margin:10px 0"><strong>' + esc(p.q) + '</strong><select class="pairsel" id="sel' + k + '"><option value="">— Choisir —</option>' + pool.map(function(a){ return '<option>' + esc(a) + '</option>'; }).join("") + '</select></div>';
    });
  }
  h += '<button id="valbtn" onclick="validate()">Valider</button>';
  card.innerHTML = h;
  Array.prototype.forEach.call(card.querySelectorAll('.segment-prog'), function(seg){
    seg.addEventListener('click', function(){ etat.qIndex = Number(seg.getAttribute('data-qidx')); renderQCM(); });
  });
}
function markSel(){
  Array.prototype.forEach.call(document.querySelectorAll('label.opt'), function(l){ l.classList.remove('sel'); });
  Array.prototype.forEach.call(document.querySelectorAll('input[name=q]'), function(inp){
    if(inp.checked) inp.closest('label').classList.add('sel');
  });
}
function validate(){
  if(etat.answered) return;
  var Q = obtenirQcmActifs();
  var q = Q[etat.qIndex];
  var ok = false, fb = "";
  if(q.type === "single" || q.type === "multi"){
    var selD = Array.prototype.map.call(document.querySelectorAll('input[name=q]:checked'), function(i){ return +i.value; });
    var sel = selD.map(function(d){ return etat.perm[d]; });
    var corr = q.options.map(function(o, k){ return o.correct ? k : -1; }).filter(function(k){ return k >= 0; });
    ok = q.type === "single" ? (sel.length === 1 && corr.indexOf(sel[0]) >= 0) : (sel.length === corr.length && sel.every(function(s){ return corr.indexOf(s) >= 0; }));
    etat.perm.forEach(function(orig, d){
      var el = document.getElementById('opt' + d);
      if(q.options[orig].correct) el.classList.add('good');
      else if(selD.indexOf(d) >= 0) el.classList.add('bad');
      el.querySelector('input').disabled = true;
    });
    etat.ans[etat.qIndex] = { ok: ok, given: sel };
    fb = corr.map(function(k){ return q.options[k].feedback; }).filter(Boolean).join("<br><br>");
  } else if(q.type === "short" || q.type === "long"){
    var inp = document.getElementById(q.type === "short" ? 'shortin' : 'longin');
    var v = (inp.value || "").trim();
    if(q.type === "long"){
      if(v.length < 40){ alert("Rédigez au moins quelques phrases avant de valider."); return; }
      fb = q.feedback || "";
      ok = true;
    } else {
      ok = q.answers.some(function(a){ return norm(a) === norm(v); });
      fb = q.feedback || ("Réponse attendue : " + q.answers[0]);
    }
    inp.disabled = true;
    etat.ans[etat.qIndex] = { ok: ok, given: v };
  } else if(q.type === "matching"){
    var allOk = true;
    q.pairs.forEach(function(p, k){
      var s = document.getElementById('sel' + k);
      if(norm(s.value) !== norm(p.a)) allOk = false;
      s.disabled = true;
    });
    ok = allOk;
    etat.ans[etat.qIndex] = { ok: ok, given: q.pairs.map(function(p, k){ return document.getElementById('sel' + k).value; }) };
    fb = "Associations correctes : " + q.pairs.map(function(p){ return p.q + " → " + p.a; }).join(" ; ");
  }
  if(ok) etat.score++;
  etat.answered = true;
  etat.performances.reponses[q.id] = { ok: ok, question: q.name, date: new Date().toISOString() };
  var seg = card.querySelector('.segment-prog[data-qidx="' + etat.qIndex + '"]');
  if(seg){ seg.classList.remove('courant'); seg.classList.add(ok ? 'fait-ok' : 'fait-ko'); }
  sauverEtat();
  var rep = '<button class="ghost" onclick="redoQ()" style="margin-top:10px">← Refaire cette question</button> <button onclick="nextQ()">' + (etat.qIndex + 1 < Q.length ? "Question suivante →" : "Voir le score") + '</button>';
  card.insertAdjacentHTML('beforeend', '<div class="fb ' + (ok ? 'ok' : 'no') + '"><strong>' + (ok ? "Réponse acceptée ✔" : "Explication") + '</strong><br>' + fb + '</div>' + rep);
}
function redoQ(){
  var a = etat.ans[etat.qIndex];
  if(a && a.ok) etat.score--;
  delete etat.ans[etat.qIndex];
  sauverEtat();
  renderQCM();
}
function nextQ(){
  var Q = obtenirQcmActifs();
  etat.qIndex++;
  sauverEtat();
  if(etat.qIndex < Q.length) renderQCM();
  else renderScoreQCM();
}
function renderScoreQCM(){
  var Q = obtenirQcmActifs();
  var n = Q.length, s = etat.score, pct = Math.round(100 * s / Math.max(1, n));
  card.innerHTML = '<h2 class="score">' + (pct >= 80 ? "🏆 " : "") + 'Score<span class="big">' + s + ' / ' + n + '</span>' + pct + '%</h2><div class="bar"><div id="scorebar" style="width:0%"></div></div><div style="text-align:center"><button onclick="reviewQCM()">Revoir les réponses</button> <button class="ghost" onclick="restartQCM()">Refaire</button></div>';
  setTimeout(function(){ var b = document.getElementById('scorebar'); if(b) b.style.width = pct + '%'; }, 100);
}
function reviewQCM(){
  var Q = obtenirQcmActifs();
  var h = '<div style="margin-bottom:10px;font-weight:700;color:var(--acc)">Récapitulatif</div>';
  Q.forEach(function(q, k){
    var a = etat.ans[k] || { ok: false, given: null };
    h += '<div class="rq"><p class="qtext">' + (k + 1) + '. ' + esc(q.name) + '</p>';
    if(q.options){
      q.options.forEach(function(o, j){
        var picked = a.given && a.given.indexOf(j) >= 0;
        var cls = o.correct ? 'good' : (picked ? 'bad' : '');
        h += '<div class="opt ' + cls + '">' + (o.correct ? "✔ " : "✖ ") + esc(o.text) + (picked ? ' <em>(votre réponse)</em>' : '') + '</div>';
      });
      var corr = q.options.filter(function(o){ return o.correct; }).map(function(o){ return o.feedback || o.text; }).join("<br><br>");
      h += '<div class="fb ' + (a.ok ? 'ok' : 'no') + '">' + corr + '</div>';
    } else if(q.pairs){
      q.pairs.forEach(function(p, j){
        var gv = a.given ? a.given[j] : "";
        h += '<p>' + esc(p.q) + ' → <em>' + esc(gv || "—") + '</em>' + (norm(gv) === norm(p.a) ? ' ✔' : ' <span class="mini">(attendu : ' + esc(p.a) + ')</span>') + '</p>';
      });
    } else {
      h += '<div class="fb ' + (a.ok ? 'ok' : 'no') + '">' + esc(a.given || "") + (q.feedback ? '<br><br>' + esc(q.feedback) : '') + '</div>';
    }
    h += '</div>';
  });
  h += '<div style="text-align:center"><button onclick="restartQCM()">Refaire</button> <button class="ghost" onclick="renderScoreQCM()">Retour au score</button></div>';
  card.innerHTML = h;
}
function restartQCM(){ etat.qIndex = 0; etat.score = 0; etat.ans = {}; sauverEtat(); renderQCM(); }

document.getElementById('btn-hamburger').onclick = function(){
  var w = document.createElement('div');
  w.style.cssText = "position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:60;display:flex;align-items:flex-start;justify-content:flex-end;padding:56px 18px";
  w.onclick = function(e){ if(e.target === w) w.remove(); };
  var themes = ["pronote","moderne","manuscrit","nuit"];
  var box = document.createElement('div');
  box.className = 'menubox';
  box.innerHTML = '<div class="mtitle">TG — Marx</div>'
    + '<button id="m-theme">🎨 Thème : ' + etat.theme + '</button>'
    + '<button id="m-taille">🔎 Taille : ' + etat.taille + ' px</button>'
    + '<button id="m-export">📤 Sauvegarde (JSON)</button>'
    + '<button id="m-import">📥 Importer (JSON)</button>'
    + '<button id="m-bilan">✓ Bilan des performances</button>';
  w.appendChild(box);
  document.body.appendChild(w);
  box.querySelector('#m-theme').onclick = function(){ etat.theme = themes[(themes.indexOf(etat.theme) + 1) % themes.length]; document.body.setAttribute('data-theme', etat.theme); this.innerHTML = '🎨 Thème : ' + etat.theme; sauverEtat(); };
  box.querySelector('#m-taille').onclick = function(){ var t = [16,18,20]; etat.taille = t[(t.indexOf(etat.taille) + 1) % t.length]; document.documentElement.style.setProperty('--taille-corps', etat.taille + 'px'); this.innerHTML = '🔎 Taille : ' + etat.taille + ' px'; sauverEtat(); };
  box.querySelector('#m-export').onclick = function(){ w.remove(); exporterJSON(); };
  box.querySelector('#m-import').onclick = function(){ w.remove(); document.getElementById('fichier-import').click(); };
  box.querySelector('#m-bilan').onclick = function(){
    w.remove();
    var reps = Object.keys(etat.performances.reponses).map(function(k){ return etat.performances.reponses[k]; });
    var bonnes = reps.filter(function(r){ return r.ok; }).length;
    alert("BILAN — TG Marx : matérialisme historique\n\nQuestions traitées : " + reps.length + "\nRéponses justes : " + bonnes + "\nRédaction en cours : " + (editeur.innerText || "").length + " caractères\nStrates de mots-clés : " + etat.stratesTags.length);
  };
};
function exporterJSON(){
  etat.contenuHTML = editeur.innerHTML;
  var payload = { date: new Date().toISOString(), sujetActifId: etat.sujetActifId, texteBrut: editeur.innerText, contenuHTML: etat.contenuHTML, stratesTags: etat.stratesTags, tagsSelectionnes: etat.tagsSelectionnes, performances: etat.performances };
  var a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([JSON.stringify(payload, null, 2)], { type: "application/json" }));
  a.download = "tg-marx-" + payload.date.slice(0, 10) + ".json";
  document.body.appendChild(a); a.click(); a.remove();
}
document.getElementById('fichier-import').addEventListener('change', function(e){
  var f = e.target.files[0];
  e.target.value = "";
  if(!f) return;
  var fr = new FileReader();
  fr.onload = function(){
    try {
      var doc = JSON.parse(fr.result);
      if(doc.contenuHTML){ editeur.innerHTML = editeur.innerHTML + doc.contenuHTML; etat.contenuHTML = editeur.innerHTML; }
      if(Array.isArray(doc.stratesTags)) etat.stratesTags = etat.stratesTags.concat(doc.stratesTags);
      if(doc.performances && doc.performances.reponses) etat.performances.reponses = Object.assign({}, etat.performances.reponses, doc.performances.reponses);
      sauverEtat(); rendreCascadeTags();
      alert("Session restaurée.");
    } catch(err){ alert("Fichier JSON invalide."); }
  };
  fr.readAsText(f);
});

function dessinerRegle(){
  var h = document.getElementById('regle-h');
  var px = 37.8;
  h.innerHTML = "";
  var largCm = Math.floor((feuille.clientWidth - 184) / px);
  for(var c = 0; c <= largCm; c++){
    var t = document.createElement('span');
    t.style.cssText = "position:absolute;bottom:0;width:1px;height:" + (c % 2 === 0 ? 9 : 5) + "px;left:" + (c * px) + "px;background:currentColor";
    h.appendChild(t);
  }
}

document.body.setAttribute('data-theme', etat.theme || "pronote");
document.documentElement.style.setProperty('--taille-corps', (etat.taille || 18) + "px");
if(etat.contenuHTML) editeur.innerHTML = etat.contenuHTML;
genererSujets();
rendreMenuTitres();
rendreTextes();
rendreCascadeTags();
dessinerRegle();
window.addEventListener('resize', dessinerRegle);
if(!etat.qcmActifsIds || !etat.qcmActifsIds.length){
  etat.qcmActifsIds = listeSujets[0].qcmIds.slice();
  sauverEtat();
}
zoneQcmWrapper.hidden = false;
renderQCM();
</script>
