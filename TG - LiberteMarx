function nbsp(s){ return String(s).replace(/ ([;:!?])/g,"\u00A0$1"); }
function esc(s){ return nbsp(String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;")); }
function norm(s){ return String(s||"").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/[^a-z0-9 ]/g,"").replace(/\s+/g," ").trim(); }
function shuffle(a){ for(var i=a.length-1;i>0;i--){ var j=Math.floor(Math.random()*(i+1)), t=a[i]; a[i]=a[j]; a[j]=t; } return a; }

var listeSujets = [];
function genererSujets(){
  var s = [];
  s.push({ id:"s-tous", titre:"Marx et le matérialisme historique : l'homme, un être de rapports ?", qcmIds: BASE_QCM.map(function(q){ return q.id; }) });
  var parSc = {};
  BASE_QCM.forEach(function(q){ (parSc[q.scenario] = parSc[q.scenario] || []).push(q.id); });
  Object.keys(parSc).forEach(function(sc, i){
    s.push({ id:"s-sc-" + i, titre:sc + " : quelles forces à l'œuvre ?", qcmIds: parSc[sc] });
  });
  listeSujets = s;
  if(!etat.sujetActifId || !listeSujets.some(function(x){ return x.id === etat.sujetActifId; })) etat.sujetActifId = listeSujets[0].id;
}
function rendreMenuTitres(){
  var actif = listeSujets.filter(function(x){ return x.id === etat.sujetActifId; })[0] || listeSujets[0];
  document.getElementById('titre-sujet-actif').textContent = actif ? actif.titre : "";
  var l = document.getElementById('liste-sujets-generes');
  l.innerHTML = "";
  listeSujets.forEach(function(sujet){
    var b = document.createElement('button');
    b.type = "button";
    b.className = "option-sujet" + (sujet.id === etat.sujetActifId ? " actif" : "");
    b.innerHTML = '<span class="intitule-sujet">' + esc(sujet.titre) + '</span>';
    b.onclick = function(){
      etat.sujetActifId = sujet.id;
      etat.qcmActifsIds = sujet.qcmIds.slice();
      etat.qIndex = 0; etat.score = 0; etat.ans = {}; etat.answered = false;
      sauverEtat();
      l.hidden = true;
      rendreMenuTitres();
      renderQCM();
    };
    l.appendChild(b);
  });
}
